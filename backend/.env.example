# Copiar a backend/.env para correr sin Docker. NO subir el .env real al repo.
DATABASE_URL=postgresql+psycopg://consultas:consultas@localhost:54322/consultas_dev
REDIS_URL=redis://localhost:63792/0
JWT_SECRETO=cambiar-este-secreto-en-produccion

# Sin clave se usa el clasificador simulado por reglas (gratis y determinista)
ANTHROPIC_API_KEY=
LLM_MODELO=claude-sonnet-5-5
LLM_TIMEOUT_SEGUNDOS=30
LLM_MAX_REINTENTOS=3
LLM_ESFUERZO=low
LLM_FALLBACK_SERVIDOR=true
FORZAR_CLASIFICADOR_SIMULADO=false
